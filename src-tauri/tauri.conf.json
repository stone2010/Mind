{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind",
  "version": "0.1.1",
  "identifier": "com.mind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mind",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "shortDescription": "Mind — a calm AI chat client for Windows",
    "longDescription": "Mind is a calm, model-agnostic AI chat client for Windows. Connect DeepSeek and start chatting right away."
  }
}
